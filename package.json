    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.16.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "fflate": "^0.8.3",
    "prettier": "^3.10.0"
  }
